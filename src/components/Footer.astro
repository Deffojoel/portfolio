---
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__in">
    <p>© {year} {profile.name}</p>
    <ul class="footer__links">
      <li><a class="link" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a class="link" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="link" href={`${base}mentions-legales/`}>Mentions légales</a></li>
      <li><a class="link" href={`${base}confidentialite/`}>Confidentialité</a></li>
    </ul>
  </div>
</footer>
